{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "kamana-jewellers-site",
  "account_id": "3493edd92cf102182de0def08c14316b",
  "main": "cloudflare/worker.js",
  "compatibility_date": "2026-10-30",
  "assets": {
    "directory": "./.cloudflare-assets",
    "binding": "ASSETS",
    "run_worker_first": true
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "kamana-jewellers",
      // Replace with the ID of the D1 database created in the Cloudflare dashboard.
      "database_id": "19fd9a95-87d1-4085-b1d9-8a7ae2c842e1",
      "migrations_dir": "migrations"
    }
  ],
  "triggers": {
    "crons": ["15 4 * * *"]
  },
  "observability": {
    "enabled": true
  }
}
